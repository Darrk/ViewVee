# Copy this file to turnserver.conf and replace every CHANGE_ME value.
# Restrict the resulting file to the deployment administrator.

listening-port=3478
tls-listening-port=5349
listening-ip=172.31.41.36
relay-ip=172.31.41.36
external-ip=3.70.31.177

realm=turn.viewvee.com
server-name=turn.viewvee.com
fingerprint
use-auth-secret
static-auth-secret=CHANGE_ME_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS

# Keep the relay range deliberately bounded and open the same UDP range in the
# provider firewall and the host firewall.
min-port=49160
max-port=49260

# Defensive defaults. Tune quotas using measured concurrent family sessions.
user-quota=4
total-quota=500
max-bps=1000000
stale-nonce=600
no-multicast-peers
no-loopback-peers
no-cli
no-software-attribute

log-file=stdout
simple-log

# Enable turns:// only after mounting valid certificate files.
cert=fullchain.pem
pkey=privkey.pem
