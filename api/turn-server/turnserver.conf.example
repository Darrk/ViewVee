# Copy this file to turnserver.conf and replace every CHANGE_ME value.
# Restrict the resulting file to the deployment administrator.

listening-port=3478
tls-listening-port=5349
listening-ip=172.31.41.36
relay-ip=172.31.41.36
external-ip=3.70.31.177

realm=turn.viewvee.com
server-name=turn.viewvee.com
fingerprint
use-auth-secret
static-auth-secret=CHANGE_ME_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS

# Keep the relay range deliberately bounded and open the same UDP range in the
# provider firewall and the host firewall.
min-port=49160
max-port=49260

# Each allocation uses one relay port, so total-quota must not exceed the
# port range size. Defensive defaults. Tune quotas using measured concurrent family sessions.
user-quota=4
total-quota=100
max-bps=1000000
stale-nonce=600
no-multicast-peers
no-loopback-peers
# Block relaying to private, link-local and cloud metadata addresses.
denied-peer-ip=0.0.0.0-0.255.255.255
denied-peer-ip=10.0.0.0-10.255.255.255
denied-peer-ip=100.64.0.0-100.127.255.255
denied-peer-ip=169.254.0.0-169.254.255.255
denied-peer-ip=172.16.0.0-172.31.255.255
denied-peer-ip=192.168.0.0-192.168.255.255
no-cli
no-software-attribute

log-file=stdout
simple-log

# Enable turns:// only after mounting valid certificate files.
cert=fullchain.pem
pkey=privkey.pem
